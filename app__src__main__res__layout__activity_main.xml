<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice Changer"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready - Record your voice"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:padding="15dp"
            android:background="@drawable/bg_rounded"
            android:backgroundTint="@color/surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="● RECORD"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/success" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="⏹ STOP"
                android:textSize="14sp"
                android:textStyle="bold"
                android:enabled="false"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/error" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="▶ PLAY LAST RECORDING"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp"
            android:backgroundTint="@color/primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎭 Voice Effect"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/spinner_effects"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 Pitch"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_primary" />

        <SeekBar
            android:id="@+id/seekbar_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Speed"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_primary" />

        <SeekBar
            android:id="@+id/seekbar_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 Volume"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_primary" />

        <SeekBar
            android:id="@+id/seekbar_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to use:\n1. Choose effect + adjust pitch/speed\n2. Press RECORD and speak\n3. Press STOP to save\n4. Press PLAY LAST anytime"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:background="@drawable/bg_rounded"
            android:backgroundTint="@color/surface" />

    </LinearLayout>
</ScrollView>
